    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.58.0",
    "animejs": "^4.5.0",
    "jspdf": "^4.2.1",
    "motion": "^13.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "three": "^0.186.0"
  },
