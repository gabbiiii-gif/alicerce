  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "sync": "npm run build && cap sync",
    "android:abrir": "npm run build && cap sync android && cap open android",
