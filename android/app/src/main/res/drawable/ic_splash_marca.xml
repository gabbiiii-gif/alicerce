<!--
  A marca do Alicerce (Marco: o pórtico sobre a laje) como vetor, para a tela de abertura
  do sistema e para o ícone adaptativo do app.

  Vetor e não PNG: esta imagem aparece em telas de densidade muito diferente e é a
  primeira coisa que se vê do app — serrilhado aqui é a primeira impressão.

  Sobre o navy, o pórtico é branco e a laje é o azul da marca, como no ícone desenhado.

  O tamanho não é o da marca original: no Android 12 em diante o sistema recorta este
  ícone num CÍRCULO de 66 de diâmetro no meio dos 108. A marca desenhada ocupa 64 x 62
  na caixa original de 72 x 64; na escala 0,68 vira 43,5 x 42,2, e a diagonal (60,6) cabe
  no círculo com folga para as pontas arredondadas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.68"
        android:scaleY="0.68"
        android:translateX="29.52"
        android:translateY="31.56">
        <path
            android:pathData="M10,40 L36,8 L62,40"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="12"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:fillColor="#1B8FE8"
            android:pathData="M8,52 h56 a4,4 0 0 1 4,4 v4 a4,4 0 0 1 -4,4 h-56 a4,4 0 0 1 -4,-4 v-4 a4,4 0 0 1 4,-4 z" />
    </group>
</vector>
